{
  "manifest_version": 3,
  "name": "ChessListener",
  "version": "0.1.0",
  "description": "Passively records positions from your Chess.com games to a local native application.",

  "permissions": [
    "nativeMessaging"
  ],

  "host_permissions": [
    "https://www.chess.com/*"
  ],

  "background": {
    "scripts": [
      "background.js"
    ]
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "chess-listener@local"
    }
  }
}
